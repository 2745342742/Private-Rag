# 阿里云百炼 API Key（控制台创建），变量名沿用 OPENAI_API_KEY 以兼容现有代码
OPENAI_API_KEY=sk-your-bailian-api-key
# 百炼 OpenAI 兼容模式（北京示例）；新加坡等地域请换对应地址
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_MODE=chat
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Qdrant Cloud（推荐；docker compose 默认不启本地 Qdrant）
# https://cloud.qdrant.io/
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
# 若只用本机 Qdrant：docker compose -f docker/docker-compose.qdrant.yaml up -d
# QDRANT_URL=http://host.docker.internal:6333
# QDRANT_API_KEY=

RAG_CONFIG=configs/default.china.yaml
RAG_SKIP_PREFLIGHT=0

# 本机开发前端默认 5172；Docker 一键部署前端为 8080（compose 会覆盖）
KNOWLEDGE_CORS_ALLOW_ORIGINS=http://localhost:5172,http://127.0.0.1:5172,http://localhost:8080,http://127.0.0.1:8080

# ---- 平台 API ----
# 本机 Postgres 示例：
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rag_demo
# Docker Compose 中会覆盖为：postgresql://postgres:postgres@db:5432/rag_demo

JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=72

# 评测题级并行数（默认 2；建议 2～3，过大易触发模型限流）
EVAL_MAX_WORKERS=2
